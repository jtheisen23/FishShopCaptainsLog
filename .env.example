# --- Server ---
PORT=3000
NODE_ENV=production
# Public URL of the app; used for links inside recap emails.
APP_URL=https://captainslog.example.com
# Mark session cookies Secure. Leave true whenever you serve over HTTPS.
SECURE_COOKIES=true
# Set true when running behind a reverse proxy / platform load balancer.
TRUST_PROXY=true

# --- Data ---
# Postgres connection string. Set this in production (Neon, Supabase, RDS…).
# Leave it UNSET for local development and the app runs an embedded Postgres
# out of PGLITE_DIR — nothing to install, no server to start.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where the embedded database keeps its files when DATABASE_URL is unset.
PGLITE_DIR=./data/pgdata

# Verify the database server's TLS certificate. Leave DATABASE_SSL on for any
# hosted provider. Only set DATABASE_SSL=false for a local server.
DATABASE_SSL=true
DATABASE_SSL_STRICT=false

# --- Restaurant ---
TIMEZONE=America/Los_Angeles
BRAND_NAME=Fish Shop Captain's Log

# --- Email (shift recaps) ---
# Without these the app still works; recaps just can't be emailed.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace-me
MAIL_FROM="Captain's Log <no-reply@example.com>"

# --- First run only (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=gm@example.com
SEED_ADMIN_NAME=General Manager
SEED_ADMIN_PASSWORD=change-this-now
